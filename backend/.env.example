PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clearair_ai?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google AI Studio Gemini API Key (for ClearAir AI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Air Quality & Weather API Keys
WAQI_API_TOKEN=your_waqi_api_token
OPENWEATHER_API_KEY=your_openweather_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Frontend URL on Vercel (for CORS)
CLIENT_URL=https://your-frontend.vercel.app
